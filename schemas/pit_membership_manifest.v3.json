{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pit_membership_manifest.v3.json",
  "title": "CSI 800 PIT Membership Manifest V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "generated_at",
    "index_code",
    "coverage_start_month",
    "coverage_end_month",
    "pit_months_expected",
    "pit_months_observed",
    "snapshots",
    "union_instrument_count",
    "union_instrument_ids",
    "stage_status",
    "remaining_blockers",
    "locked_test_status",
    "locked_test_consumed",
    "manifest_sha256",
    "pit_snapshot_count",
    "snapshot_dates",
    "missing_months",
    "duplicate_member_count",
    "zero_weight_count_by_snapshot",
    "weight_sum_by_snapshot"
  ],
  "properties": {
    "schema_version": {
      "const": "pit-membership-manifest.v3"
    },
    "experiment_id": {
      "const": "a-share-technical-alpha-feasibility-tushare-p1-v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "index_code": {
      "const": "000906.SH"
    },
    "coverage_start_month": {
      "const": "2017-12"
    },
    "coverage_end_month": {
      "const": "2023-12"
    },
    "pit_months_expected": {
      "const": 73
    },
    "pit_months_observed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 73
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "union_instrument_count": {
      "type": "integer",
      "minimum": 0
    },
    "union_instrument_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{6}\\.(?:SH|SZ)$"
      },
      "uniqueItems": true
    },
    "stage_status": {
      "enum": [
        "PIT_MEMBERSHIP_READY",
        "BLOCKED_PIT_MEMBERSHIP"
      ]
    },
    "remaining_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "locked_test_status": {
      "$ref": "pit_membership_coverage_report.v3.json#/$defs/locked"
    },
    "locked_test_consumed": {
      "const": false
    },
    "manifest_sha256": {
      "$ref": "pit_membership_coverage_report.v3.json#/$defs/sha256"
    },
    "pit_snapshot_count": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "uniqueItems": true
    },
    "missing_months": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "duplicate_member_count": {
      "type": "integer",
      "minimum": 0
    },
    "zero_weight_count_by_snapshot": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "weight_sum_by_snapshot": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/evidence_decimal"
      }
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_id",
        "weight"
      ],
      "properties": {
        "instrument_id": {
          "type": "string",
          "pattern": "^[0-9]{6}\\.(?:SH|SZ)$"
        },
        "weight": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^(?:0(?:\\.[0-9]{1,999})?|[1-9][0-9]{0,999}(?:\\.[0-9]{1,999})?)$"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "snapshot_date",
        "members",
        "weight_sum",
        "weight_tolerance",
        "component_count_adjustment_evidence",
        "source_response_sha256",
        "zero_weight_count",
        "weight_sum_hard_min",
        "weight_sum_hard_max",
        "weight_sum_warning_min",
        "weight_sum_warning_max",
        "warnings"
      ],
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "snapshot_date": {
          "type": "string",
          "format": "date"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "uniqueItems": true
        },
        "weight_sum": {
          "$ref": "#/$defs/evidence_decimal"
        },
        "weight_tolerance": {
          "$ref": "#/$defs/evidence_decimal"
        },
        "component_count_adjustment_evidence": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_response_sha256": {
          "$ref": "pit_membership_coverage_report.v3.json#/$defs/sha256"
        },
        "zero_weight_count": {
          "type": "integer",
          "minimum": 0
        },
        "weight_sum_hard_min": {
          "const": "99.5"
        },
        "weight_sum_hard_max": {
          "const": "100.5"
        },
        "weight_sum_warning_min": {
          "const": "99.95"
        },
        "weight_sum_warning_max": {
          "const": "100.05"
        },
        "warnings": {
          "type": "array",
          "items": {
            "enum": [
              "weight_sum_outside_warning_range"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "evidence_decimal": {
      "type": "string",
      "maxLength": 2004,
      "pattern": "^(?:0(?:\\.[0-9]{1,1000})?|[1-9][0-9]{0,1003}(?:\\.[0-9]{1,1000})?)$"
    }
  }
}

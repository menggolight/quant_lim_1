{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tushare_alpha_feasibility_continuation_parent_reuse_stage.v1.json",
  "title": "P1.5C Parent Reuse Stage V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "staged_at", "continuation_run_id",
    "continuation_claim_sha256", "reuse_manifest_sha256",
    "collection_plan_sha256", "parent", "successful_prefix_count",
    "reused_task_artifacts", "first_unfinished_evidence",
    "child_completed_prefix_count", "first_unfinished_task_id",
    "next_task_ordinal", "parent_terminal_quarantine_copied",
    "locked_test_status", "locked_test_consumed", "stage_sha256"
  ],
  "properties": {
    "schema_version": {"const": "tushare-alpha-feasibility-continuation-parent-reuse-stage.v1"},
    "staged_at": {"type": "string", "format": "date-time"},
    "continuation_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,95}$"},
    "continuation_claim_sha256": {"$ref": "#/$defs/sha256"},
    "reuse_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "collection_plan_sha256": {"$ref": "#/$defs/sha256"},
    "parent": {"$ref": "tushare_alpha_feasibility_continuation_reuse_manifest.v1.json#/$defs/parent_binding"},
    "successful_prefix_count": {"const": 19},
    "reused_task_artifacts": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {"$ref": "#/$defs/reused_task_artifact"}
    },
    "first_unfinished_evidence": {"$ref": "#/$defs/first_unfinished_evidence"},
    "child_completed_prefix_count": {"const": 19},
    "first_unfinished_task_id": {"const": "index_weight-63ab4e7a5df236828d4f750812809bc78a6e1f8e9cfdad64c8128431da6a741b"},
    "next_task_ordinal": {"const": 20},
    "parent_terminal_quarantine_copied": {"const": false},
    "locked_test_status": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/locked"},
    "locked_test_consumed": {"const": false},
    "stage_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "pattern": "^index_weight-[0-9a-f]{64}$"},
    "reused_task_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "task_id", "task_sha256", "parent_raw_artifact_sha256",
        "parent_response_file_sha256", "child_raw_artifact_sha256",
        "child_response_file_sha256", "child_import_artifact_sha256",
        "import_schema_version", "request_origin", "network_request_count"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 19},
        "task_id": {"$ref": "#/$defs/task_id"},
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "parent_raw_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "parent_response_file_sha256": {"$ref": "#/$defs/sha256"},
        "child_raw_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "child_response_file_sha256": {"$ref": "#/$defs/sha256"},
        "child_import_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "import_schema_version": {"const": "tushare-alpha-feasibility-task-import.v2"},
        "request_origin": {"const": "offline_parent_run_reuse"},
        "network_request_count": {"const": 0}
      }
    },
    "first_unfinished_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal", "task_id", "task_sha256", "parent_started_artifact_sha256",
        "parent_attempt_artifact_sha256_by_number",
        "child_started_artifact_sha256",
        "child_attempt_artifact_sha256_by_number", "parent_attempt_count",
        "next_attempt_number", "parent_terminal_quarantine_copied"
      ],
      "properties": {
        "ordinal": {"const": 20},
        "task_id": {"const": "index_weight-63ab4e7a5df236828d4f750812809bc78a6e1f8e9cfdad64c8128431da6a741b"},
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "parent_started_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "parent_attempt_artifact_sha256_by_number": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "child_started_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "child_attempt_artifact_sha256_by_number": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "parent_attempt_count": {"const": 1},
        "next_attempt_number": {"const": 2},
        "parent_terminal_quarantine_copied": {"const": false}
      }
    }
  }
}

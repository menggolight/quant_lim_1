{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/schemas/exposure_hysteresis_policy.v2.json",
  "title": "Experiment V3 diagnostic-bound exposure hysteresis policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_id", "policy_version", "artifact_status",
    "preregistered_at", "fallback_behavior", "policy_source_sha256",
    "experiment_spec_sha256", "policy_admission_receipt_sha256", "rules",
    "policy_sha256"
  ],
  "properties": {
    "schema_version": {"const": "exposure-hysteresis-policy.v2"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "artifact_status": {"const": "preregistered_frozen"},
    "preregistered_at": {"type": "string", "format": "date-time"},
    "fallback_behavior": {"const": "HOLD_CURRENT"},
    "policy_source_sha256": {"$ref": "#/$defs/sha256"},
    "experiment_spec_sha256": {"$ref": "#/$defs/sha256"},
    "policy_admission_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "rules": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/rule"}},
    "policy_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["RISK_OFF", "DEFENSIVE", "NEUTRAL", "RISK_ON"]},
    "category": {
      "enum": [
        "CSI800_TOTAL_RETURN_TREND", "MARKET_BREADTH", "REALIZED_VOLATILITY",
        "MARKET_DRAWDOWN", "ALPHA_PREDICTION_DISTRIBUTION", "ACCOUNT_DRAWDOWN"
      ]
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "operator", "threshold"],
      "properties": {
        "category": {"$ref": "#/$defs/category"},
        "operator": {"enum": ["LT", "LTE", "GT", "GTE"]},
        "threshold": {"type": "number"}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["target_state", "conditions", "required_consecutive_sessions", "reason_code"],
      "properties": {
        "target_state": {"$ref": "#/$defs/state"},
        "conditions": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/condition"}},
        "required_consecutive_sessions": {"type": "integer", "minimum": 2},
        "reason_code": {"type": "string", "minLength": 1}
      }
    }
  }
}

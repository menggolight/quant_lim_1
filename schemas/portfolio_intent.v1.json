{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/schemas/portfolio_intent.v1.json",
  "title": "Adaptive exposure PortfolioIntent v1",
  "description": "Frozen portfolio intent. Runtime validation must additionally recompute hashes, timestamp ordering, weight sums, source admission, and strategy state; Schema validity alone grants no execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "strategy_id",
    "decision_at",
    "available_at",
    "frozen_at",
    "intent_type",
    "target_gross_exposure",
    "target_weights",
    "reason_codes",
    "signal_sha256",
    "market_data_sha256",
    "model_sha256",
    "risk_state_sha256",
    "intent_sha256",
    "live_supported"
  ],
  "properties": {
    "schema_version": {"const": "portfolio-intent.v1"},
    "intent_id": {"$ref": "#/$defs/identifier"},
    "strategy_id": {"const": "a-share-small-account-adaptive-exposure-v2"},
    "decision_at": {"$ref": "#/$defs/dateTime"},
    "available_at": {"$ref": "#/$defs/dateTime"},
    "frozen_at": {"$ref": "#/$defs/dateTime"},
    "intent_type": {
      "enum": [
        "ALPHA_REBALANCE",
        "NO_ALPHA_CASH",
        "DEFENSIVE_REDUCTION",
        "RISK_OFF",
        "ACCOUNT_DRAWDOWN_EXIT",
        "DATA_FAIL_CLOSED",
        "MANUAL_PAUSE"
      ]
    },
    "target_gross_exposure": {"$ref": "#/$defs/exposure"},
    "target_weights": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/instrumentId"},
      "additionalProperties": {"$ref": "#/$defs/positionWeight"},
      "maxProperties": 3
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reasonCode"}
    },
    "signal_sha256": {"$ref": "#/$defs/sha256"},
    "market_data_sha256": {"$ref": "#/$defs/sha256"},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "risk_state_sha256": {"$ref": "#/$defs/sha256"},
    "intent_sha256": {"$ref": "#/$defs/sha256"},
    "live_supported": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "intent_type": {
            "enum": ["NO_ALPHA_CASH", "RISK_OFF", "ACCOUNT_DRAWDOWN_EXIT"]
          }
        },
        "required": ["intent_type"]
      },
      "then": {
        "properties": {
          "target_gross_exposure": {"enum": ["0", "0.0", "0.00"]},
          "target_weights": {"maxProperties": 0}
        }
      },
      "else": {
        "properties": {
          "target_gross_exposure": {"$ref": "#/$defs/positiveExposure"},
          "target_weights": {"minProperties": 1}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "instrumentId": {
      "type": "string",
      "pattern": "^[0-9A-Z][0-9A-Z.]{2,31}$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "exposure": {
      "type": "string",
      "pattern": "^(?:0|0\\.[0-9]+|1(?:\\.0+)?)$"
    },
    "positiveExposure": {
      "type": "string",
      "pattern": "^(?:0\\.(?:0*[1-9][0-9]*)|1(?:\\.0+)?)$"
    },
    "positionWeight": {
      "type": "string",
      "pattern": "^0\\.(?:[0-3][0-9]*|40*)$",
      "not": {"pattern": "^0\\.0+$"}
    }
  }
}

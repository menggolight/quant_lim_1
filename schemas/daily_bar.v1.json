{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/schemas/daily_bar.v1.json",
  "title": "Normalized A-share daily bar v1",
  "description": "Structural contract for one normalized daily bar. Python domain validation additionally enforces instrument equality, unique ascending dates, the request window, OHLC relationships and non-negative activity fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instrument_id",
    "trading_date",
    "open",
    "high",
    "low",
    "close",
    "preclose",
    "volume",
    "amount",
    "currency",
    "adjustment",
    "trading_status",
    "available_at",
    "availability_status",
    "source_record_id"
  ],
  "properties": {
    "instrument_id": {
      "$ref": "#/$defs/instrumentId"
    },
    "trading_date": {
      "$ref": "#/$defs/date"
    },
    "open": {
      "$ref": "#/$defs/nonNegativeDecimalString"
    },
    "high": {
      "$ref": "#/$defs/nonNegativeDecimalString"
    },
    "low": {
      "$ref": "#/$defs/nonNegativeDecimalString"
    },
    "close": {
      "$ref": "#/$defs/nonNegativeDecimalString"
    },
    "preclose": {
      "$ref": "#/$defs/nonNegativeDecimalString"
    },
    "volume": {
      "$ref": "#/$defs/nonNegativeDecimalString"
    },
    "amount": {
      "$ref": "#/$defs/nonNegativeDecimalString"
    },
    "currency": {
      "const": "CNY"
    },
    "adjustment": {
      "enum": [
        "none",
        "qfq",
        "hfq"
      ]
    },
    "trading_status": {
      "enum": [
        "traded",
        "suspended",
        "unknown"
      ]
    },
    "available_at": {
      "$ref": "#/$defs/timezoneDateTime"
    },
    "availability_status": {
      "enum": [
        "known",
        "policy_estimated",
        "unknown",
        "current_snapshot_not_pit"
      ]
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "$defs": {
    "instrumentId": {
      "type": "string",
      "pattern": "^[0-9]{6}\\.(?:SH|SZ)$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timezoneDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nonNegativeDecimalString": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    }
  }
}

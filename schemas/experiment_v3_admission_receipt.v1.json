{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/schemas/experiment_v3_admission_receipt.v1.json",
  "title": "Experiment V3 controlled policy admission receipt",
  "description": "Self-hashed diagnostic graph binding only. No issuer exists in production and the formal controlled loader remains blocked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "issued_at", "status",
    "experiment_spec_sha256", "approved_factor_registry_sha256",
    "approved_factor_registry_frozen_at",
    "model_training_receipt_sha256", "model_admission_receipt_sha256",
    "model_sha256", "model_frozen_at",
    "calibration_receipt_sha256", "calibration_horizon_sessions",
    "exposure_policy_source_sha256", "exposure_policy_frozen_at",
    "constructor_policy_source_sha256", "constructor_policy_frozen_at",
    "formal_loader_status", "paper_eligibility", "trade_eligibility",
    "real_money_list_allowed", "live_supported", "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "experiment-v3-admission-receipt.v1"},
    "receipt_id": {"$ref": "#/$defs/identifier"},
    "issued_at": {"type": "string", "format": "date-time"},
    "status": {"const": "diagnostic_binding_only_not_formally_admitted"},
    "experiment_spec_sha256": {"$ref": "#/$defs/sha256"},
    "approved_factor_registry_sha256": {"$ref": "#/$defs/sha256"},
    "approved_factor_registry_frozen_at": {"type": "string", "format": "date-time"},
    "model_training_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "model_admission_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "model_frozen_at": {"type": "string", "format": "date-time"},
    "calibration_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "calibration_horizon_sessions": {"type": "integer", "minimum": 1},
    "exposure_policy_source_sha256": {"$ref": "#/$defs/sha256"},
    "exposure_policy_frozen_at": {"type": "string", "format": "date-time"},
    "constructor_policy_source_sha256": {"$ref": "#/$defs/sha256"},
    "constructor_policy_frozen_at": {"type": "string", "format": "date-time"},
    "formal_loader_status": {"const": "blocked_not_implemented"},
    "paper_eligibility": {"const": false},
    "trade_eligibility": {"const": false},
    "real_money_list_allowed": {"const": false},
    "live_supported": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/schemas/exposure_state_memory.v1.json",
  "title": "Exposure state memory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_sha256", "current_state", "pending_state",
    "pending_consecutive_sessions", "last_decision_at", "last_input_snapshot_sha256",
    "state_sha256"
  ],
  "properties": {
    "schema_version": {"const": "exposure-state-memory.v1"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "current_state": {"$ref": "#/$defs/state"},
    "pending_state": {"anyOf": [{"$ref": "#/$defs/state"}, {"type": "null"}]},
    "pending_consecutive_sessions": {"type": "integer", "minimum": 0},
    "last_decision_at": {"type": ["string", "null"], "format": "date-time"},
    "last_input_snapshot_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "state_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["RISK_OFF", "DEFENSIVE", "NEUTRAL", "RISK_ON"]}
  }
}

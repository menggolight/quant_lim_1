{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/schemas/cn_equity_session.v1.json",
  "title": "Official China equity natural-date session record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "calendar_date", "is_trading_day", "session_open_at",
    "session_close_at", "available_at", "availability_status", "source_record_id"
  ],
  "properties": {
    "schema_version": {"const": "cn-equity-session-v1"},
    "calendar_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "is_trading_day": {"type": "boolean"},
    "session_open_at": {
      "oneOf": [
        {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T09:30:00\\+08:00$"},
        {"type": "null"}
      ]
    },
    "session_close_at": {
      "oneOf": [
        {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T15:00:00\\+08:00$"},
        {"type": "null"}
      ]
    },
    "available_at": {
      "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "availability_status": {"enum": ["known_at_capture", "historical_backfill_not_original_capture"]},
    "source_record_id": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}

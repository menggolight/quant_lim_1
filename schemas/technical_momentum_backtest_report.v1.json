{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technical_momentum_backtest_report.v1.json",
  "title": "Technical Momentum Development and Validation Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "strategy_id",
    "generated_at",
    "development",
    "validation",
    "locked_test_status",
    "locked_test_consumed",
    "remaining_blockers",
    "safety",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "technical-momentum-backtest-report.v1"},
    "strategy_id": {"const": "a-share-technical-momentum-adaptive-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "development": {"$ref": "#/$defs/split"},
    "validation": {"$ref": "#/$defs/split"},
    "locked_test_status": {"const": "NOT_RUN"},
    "locked_test_consumed": {"const": false},
    "remaining_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "safety": {"$ref": "technical_formal_dataset_manifest.v1.json#/$defs/safety"},
    "report_sha256": {"$ref": "technical_formal_dataset_manifest.v1.json#/$defs/sha256"}
  },
  "$defs": {
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split", "start", "end", "status", "base_cost", "stress_cost", "blockers"],
      "properties": {
        "split": {"enum": ["development", "validation"]},
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"},
        "status": {"enum": ["COMPLETED", "NOT_RUN_BLOCKED"]},
        "base_cost": {"oneOf": [{"$ref": "#/$defs/metrics"}, {"type": "null"}]},
        "stress_cost": {"oneOf": [{"$ref": "#/$defs/metrics"}, {"type": "null"}]},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "metrics": {
      "type": "object",
      "required": ["net_return", "benchmark_return", "net_active_return", "max_drawdown", "turnover", "total_cost", "cost_to_gross_profit", "exposure_state_distribution", "cash_day_fraction", "positive_half_year_count", "trade_count", "win_rate", "average_holding_period", "per_stock_pnl_contribution", "largest_stock_pnl_share", "largest_10_days_pnl_share"],
      "properties": {
        "net_return": {"type": "number"},
        "benchmark_return": {"type": "number"},
        "net_active_return": {"type": "number"},
        "max_drawdown": {"type": "number"},
        "turnover": {"type": "number", "minimum": 0},
        "total_cost": {"type": "number", "minimum": 0},
        "cost_to_gross_profit": {"type": ["number", "null"], "minimum": 0},
        "exposure_state_distribution": {"type": "object", "required": ["RISK_OFF", "DEFENSIVE", "NEUTRAL", "RISK_ON"], "additionalProperties": false, "properties": {"RISK_OFF": {"type": "number", "minimum": 0, "maximum": 1}, "DEFENSIVE": {"type": "number", "minimum": 0, "maximum": 1}, "NEUTRAL": {"type": "number", "minimum": 0, "maximum": 1}, "RISK_ON": {"type": "number", "minimum": 0, "maximum": 1}}},
        "cash_day_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "positive_half_year_count": {"type": "integer", "minimum": 0},
        "trade_count": {"type": "integer", "minimum": 0},
        "win_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "average_holding_period": {"type": ["number", "null"], "minimum": 0},
        "per_stock_pnl_contribution": {"type": "object", "additionalProperties": {"type": "number"}},
        "largest_stock_pnl_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "largest_10_days_pnl_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    }
  }
}

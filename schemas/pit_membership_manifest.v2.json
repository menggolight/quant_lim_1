{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pit_membership_manifest.v2.json",
  "title": "CSI 800 PIT Membership Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "generated_at",
    "index_code",
    "coverage_start_month",
    "coverage_end_month",
    "pit_months_expected",
    "pit_months_observed",
    "snapshots",
    "union_instrument_count",
    "union_instrument_ids",
    "stage_status",
    "remaining_blockers",
    "locked_test_status",
    "locked_test_consumed",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "pit-membership-manifest.v2"},
    "experiment_id": {"const": "a-share-technical-alpha-feasibility-tushare-p1-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "index_code": {"const": "000906.SH"},
    "coverage_start_month": {"const": "2017-12"},
    "coverage_end_month": {"const": "2023-12"},
    "pit_months_expected": {"const": 73},
    "pit_months_observed": {"type": "integer", "minimum": 0, "maximum": 73},
    "snapshots": {"type": "array", "items": {"$ref": "#/$defs/snapshot"}},
    "union_instrument_count": {"type": "integer", "minimum": 0},
    "union_instrument_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{6}\\.(?:SH|SZ)$"}, "uniqueItems": true},
    "stage_status": {"enum": ["PIT_MEMBERSHIP_READY", "BLOCKED_PIT_MEMBERSHIP"]},
    "remaining_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "locked_test_status": {"$ref": "pit_membership_coverage_report.v2.json#/$defs/locked"},
    "locked_test_consumed": {"const": false},
    "manifest_sha256": {"$ref": "pit_membership_coverage_report.v2.json#/$defs/sha256"}
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_id", "weight"],
      "properties": {
        "instrument_id": {"type": "string", "pattern": "^[0-9]{6}\\.(?:SH|SZ)$"},
        "weight": {"type": "string", "maxLength": 2000, "pattern": "^(?:0(?:\\.[0-9]{1,999})?|[1-9][0-9]{0,999}(?:\\.[0-9]{1,999})?)$"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month", "snapshot_date", "members", "weight_sum", "weight_tolerance", "component_count_adjustment_evidence", "source_response_sha256"],
      "properties": {
        "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "snapshot_date": {"type": "string", "format": "date"},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}, "uniqueItems": true},
        "weight_sum": {"$ref": "#/$defs/evidence_decimal"},
        "weight_tolerance": {"$ref": "#/$defs/evidence_decimal"},
        "component_count_adjustment_evidence": {"type": ["string", "null"], "minLength": 1},
        "source_response_sha256": {"$ref": "pit_membership_coverage_report.v2.json#/$defs/sha256"}
      }
    },
    "evidence_decimal": {
      "type": "string",
      "maxLength": 2004,
      "pattern": "^(?:0(?:\\.[0-9]{1,1000})?|[1-9][0-9]{0,1003}(?:\\.[0-9]{1,1000})?)$"
    }
  }
}

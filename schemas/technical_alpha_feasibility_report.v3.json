{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technical_alpha_feasibility_report.v3.json",
  "title": "Technical Alpha Feasibility Report V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "generated_at", "commit_sha",
    "actual_tushare_request_count_by_endpoint", "first_index_weight", "stock_basic_status",
    "stock_basic_request_count", "security_master_pit_status", "coverage_start",
    "coverage_end", "pit_months_expected", "pit_months_observed",
    "union_instrument_count", "valid_candidate_count_by_decision",
    "insufficient_history_count_by_decision", "ineligible_no_initial_price_count",
    "unexplained_market_data_gap_count", "collection_plan_sha256",
    "pit_membership_manifest_sha256", "history_manifest_sha256",
    "experiment_config_canonical_sha256", "alpha_feasibility_engine_version",
    "alpha_feasibility_engine_sha256", "reporting_gate_source_sha256",
    "daily_coverage_status", "adj_factor_coverage_status", "suspension_coverage_status",
    "benchmark_coverage_status", "development_metrics", "validation_metrics",
    "concentration_metrics", "terminal_status", "locked_test_status",
    "locked_test_consumed", "remaining_blockers", "safety", "report_sha256"
  ],
  "properties": {
    "schema_version": {"const": "technical-alpha-feasibility-report.v3"},
    "experiment_id": {"const": "a-share-technical-alpha-feasibility-tushare-p1-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actual_tushare_request_count_by_endpoint": {"$ref": "tushare_alpha_feasibility_manifest.v3.json#/properties/actual_tushare_request_count_by_endpoint"},
    "first_index_weight": {
      "oneOf": [
        {"$ref": "#/$defs/first_index_weight"},
        {"type": "null"}
      ]
    },
    "stock_basic_status": {"const": "DEFERRED_NOT_REQUIRED_FOR_ALPHA_FEASIBILITY"},
    "stock_basic_request_count": {"const": 0},
    "security_master_pit_status": {"const": "NOT_IMPLEMENTED_NOT_REQUIRED_IN_P1"},
    "coverage_start": {"const": "2017-07-01"},
    "coverage_end": {"const": "2023-12-31"},
    "pit_months_expected": {"const": 73},
    "pit_months_observed": {"type": "integer", "minimum": 0, "maximum": 73},
    "union_instrument_count": {"type": "integer", "minimum": 0},
    "valid_candidate_count_by_decision": {"$ref": "tushare_alpha_feasibility_manifest.v3.json#/$defs/count_by_decision"},
    "insufficient_history_count_by_decision": {"$ref": "tushare_alpha_feasibility_manifest.v3.json#/$defs/count_by_decision"},
    "ineligible_no_initial_price_count": {"type": "integer", "minimum": 0},
    "unexplained_market_data_gap_count": {"type": "integer", "minimum": 0},
    "collection_plan_sha256": {"oneOf": [{"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"}, {"type": "null"}]},
    "pit_membership_manifest_sha256": {"oneOf": [{"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"}, {"type": "null"}]},
    "history_manifest_sha256": {"oneOf": [{"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"}, {"type": "null"}]},
    "experiment_config_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "alpha_feasibility_engine_version": {"const": "alpha-feasibility.v1"},
    "alpha_feasibility_engine_sha256": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"},
    "reporting_gate_source_sha256": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"},
    "daily_coverage_status": {"enum": ["complete", "blocked", "not_run"]},
    "adj_factor_coverage_status": {"enum": ["complete", "blocked", "not_run"]},
    "suspension_coverage_status": {"enum": ["complete", "blocked", "not_run"]},
    "benchmark_coverage_status": {"enum": ["complete", "blocked", "not_run"]},
    "development_metrics": {"oneOf": [{"$ref": "#/$defs/scenarios"}, {"type": "null"}]},
    "validation_metrics": {"oneOf": [{"$ref": "#/$defs/scenarios"}, {"type": "null"}]},
    "concentration_metrics": {"oneOf": [{"$ref": "#/$defs/concentration"}, {"type": "null"}]},
    "terminal_status": {"enum": ["ALPHA_FEASIBILITY_GO_CANDIDATE", "ALPHA_FEASIBILITY_NO_GO", "BLOCKED_DATA", "BLOCKED_ADAPTER_PROTOCOL"]},
    "locked_test_status": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/locked"},
    "locked_test_consumed": {"const": false},
    "remaining_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "safety": {"$ref": "tushare_alpha_feasibility_manifest.v3.json#/$defs/safety"},
    "report_sha256": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "terminal_status": {
            "enum": ["ALPHA_FEASIBILITY_GO_CANDIDATE", "ALPHA_FEASIBILITY_NO_GO"]
          }
        }
      },
      "then": {
        "properties": {
          "first_index_weight": {"$ref": "#/$defs/first_index_weight_complete"},
          "valid_candidate_count_by_decision": {"minProperties": 1},
          "insufficient_history_count_by_decision": {"minProperties": 1},
          "unexplained_market_data_gap_count": {"const": 0}
        }
      }
    }
  ],
  "$defs": {
    "sha256_or_null": {
      "oneOf": [
        {"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "safe_field_array": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"},
      "uniqueItems": true
    },
    "diagnostic_field_array": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]{0,63}|sha256:[0-9a-f]{64}|type:(?:null|boolean|integer|number|string|array|object|unknown))$"
      }
    },
    "first_index_weight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_data_fields", "required_data_fields", "missing_required_data_fields",
        "extra_data_fields", "field_order_matches_canonical", "data_row_count",
        "provider_payload_sha256", "normalized_content_sha256"
      ],
      "properties": {
        "observed_data_fields": {"$ref": "#/$defs/diagnostic_field_array"},
        "required_data_fields": {"const": ["index_code", "con_code", "trade_date", "weight"]},
        "missing_required_data_fields": {"$ref": "#/$defs/safe_field_array"},
        "extra_data_fields": {"$ref": "#/$defs/safe_field_array"},
        "field_order_matches_canonical": {"type": "boolean"},
        "data_row_count": {"type": "integer", "minimum": 0},
        "provider_payload_sha256": {"$ref": "#/$defs/sha256_or_null"},
        "normalized_content_sha256": {"$ref": "#/$defs/sha256_or_null"}
      }
    },
    "first_index_weight_complete": {
      "allOf": [
        {"$ref": "#/$defs/first_index_weight"},
        {
          "properties": {
            "missing_required_data_fields": {"maxItems": 0},
            "provider_payload_sha256": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"},
            "normalized_content_sha256": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"}
          }
        }
      ]
    },
    "decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "nonnegative_decimal": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "unit_decimal": {"type": "string", "pattern": "^(?:0(?:\\.[0-9]+)?|1)$"},
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "stress"],
      "properties": {"base": {"$ref": "#/$defs/metrics"}, "stress": {"$ref": "#/$defs/metrics"}}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "net_return", "benchmark_return", "net_active_return", "max_drawdown",
        "annualized_turnover", "total_cost", "average_gross_exposure",
        "cash_day_fraction", "exposure_state_distribution", "trade_or_rebalance_count",
        "positive_month_rate", "positive_half_year_count", "worst_month",
        "per_stock_pnl_contribution", "largest_stock_pnl_share", "largest_10_days_pnl_share"
      ],
      "properties": {
        "net_return": {"$ref": "#/$defs/decimal"},
        "benchmark_return": {"$ref": "#/$defs/decimal"},
        "net_active_return": {"$ref": "#/$defs/decimal"},
        "max_drawdown": {"$ref": "#/$defs/nonnegative_decimal"},
        "annualized_turnover": {"$ref": "#/$defs/nonnegative_decimal"},
        "total_cost": {"$ref": "#/$defs/nonnegative_decimal"},
        "average_gross_exposure": {"$ref": "#/$defs/unit_decimal"},
        "cash_day_fraction": {"$ref": "#/$defs/unit_decimal"},
        "exposure_state_distribution": {
          "type": "object", "additionalProperties": false,
          "required": ["RISK_OFF", "DEFENSIVE", "NEUTRAL", "RISK_ON"],
          "properties": {
            "RISK_OFF": {"$ref": "#/$defs/unit_decimal"},
            "DEFENSIVE": {"$ref": "#/$defs/unit_decimal"},
            "NEUTRAL": {"$ref": "#/$defs/unit_decimal"},
            "RISK_ON": {"$ref": "#/$defs/unit_decimal"}
          }
        },
        "trade_or_rebalance_count": {"type": "integer", "minimum": 0},
        "positive_month_rate": {"$ref": "#/$defs/unit_decimal"},
        "positive_half_year_count": {"type": "integer", "minimum": 0},
        "worst_month": {
          "type": "object", "additionalProperties": false,
          "required": ["month", "net_return", "benchmark_return", "net_active_return"],
          "properties": {
            "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
            "net_return": {"$ref": "#/$defs/decimal"},
            "benchmark_return": {"$ref": "#/$defs/decimal"},
            "net_active_return": {"$ref": "#/$defs/decimal"}
          }
        },
        "per_stock_pnl_contribution": {"type": "object", "additionalProperties": {"$ref": "#/$defs/decimal"}},
        "largest_stock_pnl_share": {"oneOf": [{"$ref": "#/$defs/unit_decimal"}, {"type": "null"}]},
        "largest_10_days_pnl_share": {"oneOf": [{"$ref": "#/$defs/unit_decimal"}, {"type": "null"}]}
      }
    },
    "concentration": {
      "type": "object", "additionalProperties": false,
      "required": ["largest_stock_pnl_share", "largest_stock_threshold", "largest_10_days_pnl_share", "largest_10_days_threshold", "gate_passed", "issues"],
      "properties": {
        "largest_stock_pnl_share": {"oneOf": [{"$ref": "#/$defs/unit_decimal"}, {"type": "null"}]},
        "largest_stock_threshold": {"const": "0.5"},
        "largest_10_days_pnl_share": {"oneOf": [{"$ref": "#/$defs/unit_decimal"}, {"type": "null"}]},
        "largest_10_days_threshold": {"const": "0.5"},
        "gate_passed": {"type": "boolean"},
        "issues": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}

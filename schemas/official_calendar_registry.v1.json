{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/schemas/official_calendar_registry.v1.json",
  "title": "Controlled calendar-receipt allowlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "frozen_at", "entries", "trust_boundary", "registry_sha256"],
  "properties": {
    "schema_version": {"const": "official-calendar-registry.v1"},
    "registry_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "trust_boundary": {"const": "controlled_exact_receipt_allowlist"},
    "registry_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_sha256", "receipt_id", "adapter_id", "adapter_version", "source_id", "source_document_sha256"],
      "properties": {
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_id": {"type": "string", "minLength": 1},
        "adapter_id": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_document_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

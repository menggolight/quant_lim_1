{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tushare_alpha_feasibility_quarantine.v5.json",
  "title": "Tushare Alpha Feasibility Quarantine V5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "task_id",
    "endpoint",
    "plan_sha256",
    "reason",
    "failure_code",
    "raw_transport_sha256",
    "http_status",
    "response_byte_count",
    "observed_root_fields",
    "semantic_core_fields",
    "missing_semantic_core_fields",
    "transport_extension_field_names",
    "transport_extension_type_by_field",
    "transport_extension_value_sha256_by_field",
    "transport_extensions_sha256",
    "transport_extensions_byte_count",
    "upstream_code",
    "upstream_error_category",
    "business_error_classification",
    "business_error_evidence",
    "business_error_artifact_sha256",
    "terminal_attempt_number",
    "data_failure_category",
    "observed_data_fields",
    "required_data_fields",
    "missing_required_data_fields",
    "extra_data_fields",
    "field_order_matches_canonical",
    "provider_payload_sha256",
    "normalized_content_sha256",
    "extra_data_field_value_sha256_by_field",
    "data_row_count",
    "token_leak_check",
    "raw_response_persisted",
    "locked_test_status",
    "locked_test_consumed"
  ],
  "properties": {
    "schema_version": {"const": "tushare-alpha-feasibility-quarantine.v5"},
    "state": {"enum": ["RESPONSE_QUARANTINED", "TRANSPORT_ATTEMPT_QUARANTINED_NO_RESPONSE"]},
    "task_id": {"type": "string", "pattern": "^[a-z_]+-[0-9a-f]{64}$"},
    "endpoint": {"enum": ["trade_cal", "index_weight", "daily", "adj_factor", "index_daily", "suspend_d", "stock_basic"]},
    "plan_sha256": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"},
    "reason": {"type": "string", "pattern": "^[a-z0-9_]{3,96}$"},
    "failure_code": {"type": "string", "pattern": "^[a-z0-9_]{3,96}$"},
    "raw_transport_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "response_byte_count": {"type": ["integer", "null"], "minimum": 0},
    "observed_root_fields": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "semantic_core_fields": {"type": "array", "items": {"enum": ["code", "data", "msg"]}, "uniqueItems": true},
    "missing_semantic_core_fields": {"type": "array", "items": {"enum": ["code", "data", "msg"]}, "uniqueItems": true},
    "transport_extension_field_names": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9._:-]{0,127}$"}, "uniqueItems": true},
    "transport_extension_type_by_field": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9._:-]{0,127}$"},
      "additionalProperties": {"enum": ["null", "boolean", "integer", "number", "string", "array", "object"]}
    },
    "transport_extension_value_sha256_by_field": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9._:-]{0,127}$"},
      "additionalProperties": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"}
    },
    "transport_extensions_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "transport_extensions_byte_count": {"type": ["integer", "null"], "minimum": 2, "maximum": 262144},
    "upstream_code": {"type": ["integer", "null"]},
    "upstream_error_category": {"type": ["string", "null"]},
    "business_error_classification": {
      "oneOf": [
        {"$ref": "tushare_alpha_feasibility_business_error.v1.json#/$defs/classification"},
        {"type": "null"}
      ]
    },
    "business_error_evidence": {
      "oneOf": [
        {"$ref": "tushare_alpha_feasibility_business_error.v1.json#/$defs/safe_response_semantics"},
        {"type": "null"}
      ]
    },
    "business_error_artifact_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "terminal_attempt_number": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    },
    "data_failure_category": {"type": ["string", "null"]},
    "observed_data_fields": {"type": "array", "items": {"$ref": "#/$defs/diagnostic_data_field"}},
    "required_data_fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/data_field"}, "uniqueItems": true},
    "missing_required_data_fields": {"type": "array", "items": {"$ref": "#/$defs/data_field"}, "uniqueItems": true},
    "extra_data_fields": {"type": "array", "items": {"$ref": "#/$defs/data_field"}, "uniqueItems": true},
    "field_order_matches_canonical": {"type": "boolean"},
    "provider_payload_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "normalized_content_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "extra_data_field_value_sha256_by_field": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"},
      "additionalProperties": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"}
    },
    "data_row_count": {"type": "integer", "minimum": 0},
    "token_leak_check": {"enum": ["NOT_CONFIRMED", "RAW_BYTES_PASSED", "PASSED", "RAW_LEAK_REJECTED", "DECODED_LEAK_REJECTED"]},
    "raw_response_persisted": {"type": "boolean"},
    "locked_test_status": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/locked"},
    "locked_test_consumed": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {"state": {"const": "TRANSPORT_ATTEMPT_QUARANTINED_NO_RESPONSE"}},
        "required": ["state"]
      },
      "then": {
        "properties": {
          "raw_transport_sha256": {"type": "null"},
          "http_status": {"type": "null"},
          "response_byte_count": {"type": "null"},
          "observed_root_fields": {"maxItems": 0},
          "semantic_core_fields": {"maxItems": 0},
          "missing_semantic_core_fields": {"maxItems": 0},
          "transport_extension_field_names": {"maxItems": 0},
          "transport_extension_type_by_field": {"maxProperties": 0},
          "transport_extension_value_sha256_by_field": {"maxProperties": 0},
          "transport_extensions_sha256": {"type": "null"},
          "transport_extensions_byte_count": {"type": "null"},
          "upstream_code": {"type": "null"},
          "upstream_error_category": {"type": "null"},
          "business_error_classification": {"type": "null"},
          "business_error_evidence": {"type": "null"},
          "business_error_artifact_sha256": {"type": "null"},
          "data_failure_category": {"type": "null"},
          "observed_data_fields": {"maxItems": 0},
          "missing_required_data_fields": {"maxItems": 0},
          "extra_data_fields": {"maxItems": 0},
          "field_order_matches_canonical": {"const": false},
          "provider_payload_sha256": {"type": "null"},
          "normalized_content_sha256": {"type": "null"},
          "extra_data_field_value_sha256_by_field": {"maxProperties": 0},
          "data_row_count": {"const": 0},
          "token_leak_check": {"const": "NOT_CONFIRMED"},
          "raw_response_persisted": {"const": false}
        }
      }
    }
  ],
  "$defs": {
    "nullable_sha256": {
      "oneOf": [
        {"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "data_field": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"},
    "diagnostic_data_field": {
      "type": "string",
      "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]{0,63}|sha256:[0-9a-f]{64}|type:(?:null|boolean|integer|number|string|array|object|unknown))$"
    }
  }
}

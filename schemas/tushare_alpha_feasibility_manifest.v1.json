{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tushare_alpha_feasibility_manifest.v1.json",
  "title": "Tushare Alpha Feasibility Dataset Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "generated_at",
    "coverage_start",
    "coverage_end",
    "actual_tushare_request_count_by_endpoint",
    "pit_months_expected",
    "pit_months_observed",
    "union_instrument_count",
    "datasets",
    "data_status",
    "remaining_blockers",
    "locked_test_status",
    "locked_test_consumed",
    "safety",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "tushare-alpha-feasibility-manifest.v1"},
    "experiment_id": {"const": "a-share-technical-alpha-feasibility-tushare-p1-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "coverage_start": {"const": "2017-07-01"},
    "coverage_end": {"const": "2023-12-31"},
    "actual_tushare_request_count_by_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_cal", "index_weight", "daily", "adj_factor", "index_daily", "suspend_d", "stock_basic"],
      "properties": {
        "trade_cal": {"type": "integer", "minimum": 0},
        "index_weight": {"type": "integer", "minimum": 0},
        "daily": {"type": "integer", "minimum": 0},
        "adj_factor": {"type": "integer", "minimum": 0},
        "index_daily": {"type": "integer", "minimum": 0},
        "suspend_d": {"type": "integer", "minimum": 0},
        "stock_basic": {"type": "integer", "minimum": 0}
      }
    },
    "pit_months_expected": {"const": 73},
    "pit_months_observed": {"type": "integer", "minimum": 0, "maximum": 73},
    "union_instrument_count": {"type": "integer", "minimum": 0},
    "datasets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_calendar", "pit_membership", "security_master", "daily", "adj_factor", "suspension", "benchmark"],
      "properties": {
        "trade_calendar": {"$ref": "#/$defs/dataset"},
        "pit_membership": {"$ref": "#/$defs/dataset"},
        "security_master": {"$ref": "#/$defs/dataset"},
        "daily": {"$ref": "#/$defs/dataset"},
        "adj_factor": {"$ref": "#/$defs/dataset"},
        "suspension": {"$ref": "#/$defs/dataset"},
        "benchmark": {"$ref": "#/$defs/dataset"}
      }
    },
    "data_status": {"enum": ["READY", "BLOCKED_PIT_MEMBERSHIP", "BLOCKED_DATA"]},
    "remaining_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "locked_test_status": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/locked"},
    "locked_test_consumed": {"const": false},
    "safety": {"$ref": "#/$defs/safety"},
    "manifest_sha256": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"}
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "endpoint", "record_count", "coverage_start", "coverage_end", "normalized_content_sha256", "issues"],
      "properties": {
        "status": {"enum": ["complete", "missing", "partial", "invalid"]},
        "endpoint": {"type": "string", "minLength": 1},
        "record_count": {"type": "integer", "minimum": 0},
        "coverage_start": {"type": ["string", "null"], "format": "date"},
        "coverage_end": {"type": ["string", "null"], "format": "date"},
        "normalized_content_sha256": {"oneOf": [{"$ref": "pit_membership_coverage_report.v1.json#/$defs/sha256"}, {"type": "null"}]},
        "issues": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_status", "execution_realism", "paper_eligibility", "trade_eligibility", "automatic_order_submission", "live_supported"],
      "properties": {
        "research_status": {"const": "research_alpha_feasibility_only"},
        "execution_realism": {"const": "INCOMPLETE"},
        "paper_eligibility": {"const": false},
        "trade_eligibility": {"const": false},
        "automatic_order_submission": {"const": false},
        "live_supported": {"const": false}
      }
    }
  }
}

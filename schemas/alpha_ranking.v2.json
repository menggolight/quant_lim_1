{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/schemas/alpha_ranking.v2.json",
  "title": "Adaptive Exposure V2 alpha ranking",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "decision_at", "eligible_count", "rows",
    "model_sha256", "input_snapshot_sha256", "ranking_sha256"
  ],
  "properties": {
    "schema_version": {"const": "alpha-ranking.v2"},
    "status": {"enum": ["OK", "NO_ALPHA_CASH", "DATA_FAIL_CLOSED", "DIAGNOSTIC_ONLY_NOT_ADMITTED"]},
    "decision_at": {"type": "string", "format": "date-time"},
    "eligible_count": {"type": "integer", "minimum": 0},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "input_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "ranking_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row": {
      "type": "object", "additionalProperties": false,
      "required": [
        "instrument_id", "decision_at", "predicted_return", "quality_score", "timing_score",
        "percentile", "rank", "industry", "eligibility", "exclusion_codes"
      ],
      "properties": {
        "instrument_id": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ)$"},
        "decision_at": {"type": "string", "format": "date-time"},
        "predicted_return": {"type": ["number", "null"]},
        "quality_score": {"type": ["number", "null"]},
        "timing_score": {"type": ["number", "null"]},
        "percentile": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "rank": {"type": ["integer", "null"], "minimum": 1},
        "industry": {"type": ["string", "null"]},
        "eligibility": {"type": "boolean"},
        "exclusion_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

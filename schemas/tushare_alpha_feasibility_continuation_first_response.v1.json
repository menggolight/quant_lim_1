{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tushare_alpha_feasibility_continuation_first_response.v1.json",
  "title": "P1.5C First Continuation Response Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "published_at", "continuation_run_id",
    "continuation_claim_sha256", "network_process_marker_sha256",
    "task_id", "attempt_number", "safe_response_semantics",
    "retry_performed", "result", "evidence_artifact_sha256",
    "locked_test_status", "locked_test_consumed", "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": "tushare-alpha-feasibility-continuation-first-response.v1"},
    "published_at": {"type": "string", "format": "date-time"},
    "continuation_run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,95}$"},
    "continuation_claim_sha256": {"$ref": "#/$defs/sha256"},
    "network_process_marker_sha256": {"$ref": "#/$defs/sha256"},
    "task_id": {"const": "index_weight-63ab4e7a5df236828d4f750812809bc78a6e1f8e9cfdad64c8128431da6a741b"},
    "attempt_number": {"const": 2},
    "safe_response_semantics": {"$ref": "#/$defs/safe_response_semantics"},
    "retry_performed": {"type": "boolean"},
    "result": {
      "enum": [
        "FIRST_ATTEMPT_SUCCEEDED", "NOT_RETRYABLE",
        "RETRY_SUCCEEDED", "RETRY_FAILED",
        "NO_RESPONSE_TRANSPORT_INTERRUPTION",
        "RESPONSE_REJECTED_ADAPTER_PROTOCOL",
        "RESPONSE_REJECTED_DATA_VALIDATION"
      ]
    },
    "evidence_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "locked_test_status": {"$ref": "pit_membership_coverage_report.v1.json#/$defs/locked"},
    "locked_test_consumed": {"const": false},
    "evidence_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "classification": {
      "enum": [
        "RATE_LIMITED", "PERMISSION_DENIED", "INVALID_PARAMETER",
        "DATA_UNAVAILABLE", "UPSTREAM_SERVER_ERROR",
        "ACCOUNT_OR_QUOTA_LIMIT", "UPSTREAM_UNKNOWN_ERROR"
      ]
    },
    "safe_detail_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_type", "value", "sanitized_text", "semantic_category"],
      "properties": {
        "json_type": {"enum": ["null", "boolean", "integer", "number", "string", "array", "object"]},
        "value": {},
        "sanitized_text": {"type": "string", "maxLength": 1000},
        "semantic_category": {
          "oneOf": [{"$ref": "#/$defs/classification"}, {"type": "null"}]
        }
      }
    },
    "safe_response_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_code", "classification", "sanitized_msg", "msg_sha256",
        "detail_type", "safe_detail_projection", "detail_sha256",
        "request_id_sha256", "raw_transport_sha256",
        "response_body_sha256", "response_byte_count", "sanitized_params",
        "requested_fields", "requested_at", "completed_at",
        "retry_after_seconds"
      ],
      "properties": {
        "business_code": {"oneOf": [{"type": "integer"}, {"type": "null"}]},
        "classification": {
          "oneOf": [{"$ref": "#/$defs/classification"}, {"type": "null"}]
        },
        "sanitized_msg": {"oneOf": [{"type": "string", "maxLength": 1000}, {"type": "null"}]},
        "msg_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "detail_type": {
          "oneOf": [
            {"enum": ["null", "boolean", "integer", "number", "string", "array", "object"]},
            {"type": "null"}
          ]
        },
        "safe_detail_projection": {
          "oneOf": [{"$ref": "#/$defs/safe_detail_projection"}, {"type": "null"}]
        },
        "detail_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "request_id_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "raw_transport_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "response_body_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "response_byte_count": {
          "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
        },
        "sanitized_params": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "requested_fields": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"}
        },
        "requested_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "retry_after_seconds": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 300},
            {"type": "null"}
          ]
        }
      }
    }
  }
}

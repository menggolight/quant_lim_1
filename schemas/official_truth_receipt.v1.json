{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-research-os.local/schemas/official_truth_receipt.v1.json",
  "title": "Controlled official truth receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "receipt_id",
    "adapter_id",
    "adapter_version",
    "source_id",
    "truth_source",
    "dimension",
    "subject_id",
    "target_type",
    "forecast_period",
    "unit",
    "basis",
    "realized_value",
    "observation_kind",
    "release_kind",
    "release_version",
    "revision_of",
    "endpoint_url",
    "final_url",
    "http_status",
    "transport_provenance_sha256",
    "response_headers_sha256",
    "document_url",
    "request_params",
    "raw_response_sha256",
    "document_sha256",
    "observed_at",
    "available_at",
    "fetched_at",
    "mapping_valid_from",
    "mapping_valid_to",
    "mapping_version",
    "admission_status"
  ],
  "properties": {
    "contract_version": {"const": "official-truth-receipt.v1"},
    "receipt_id": {"$ref": "#/$defs/sha256"},
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "truth_source": {"type": "string", "minLength": 1},
    "dimension": {"enum": ["macro", "industry", "stock"]},
    "subject_id": {"type": "string", "minLength": 1},
    "target_type": {"type": "string", "minLength": 1},
    "forecast_period": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "basis": {"type": "string", "minLength": 1},
    "realized_value": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "observation_kind": {"enum": ["scalar", "industry_mapping"]},
    "release_kind": {"enum": ["first_release", "revision"]},
    "release_version": {"type": "integer", "minimum": 1},
    "revision_of": {"type": "string"},
    "endpoint_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "final_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "http_status": {"const": 200},
    "transport_provenance_sha256": {"$ref": "#/$defs/sha256"},
    "response_headers_sha256": {"$ref": "#/$defs/sha256"},
    "document_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "request_params": {"type": "object"},
    "raw_response_sha256": {"$ref": "#/$defs/sha256"},
    "document_sha256": {"$ref": "#/$defs/sha256"},
    "observed_at": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "mapping_valid_from": {"type": "string"},
    "mapping_valid_to": {"type": "string"},
    "mapping_version": {"type": "string"},
    "admission_status": {"const": "not_configured"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

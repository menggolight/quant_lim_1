{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/schemas/daily_pipeline_failure_receipt.v1.json",
  "title": "Adaptive Exposure V2 daily pipeline failure receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "strategy_id",
    "strategy_date",
    "effective_decision_at",
    "failed_stage",
    "failure_codes",
    "exception_type",
    "message_persisted",
    "orders_allowed",
    "automatic_submission",
    "paper_eligibility",
    "trade_eligibility",
    "live_supported",
    "failure_receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "daily-pipeline-failure-receipt.v1"},
    "strategy_id": {"const": "a-share-small-account-adaptive-exposure-v2"},
    "strategy_date": {"type": "string", "format": "date"},
    "effective_decision_at": {"type": "string", "format": "date-time"},
    "failed_stage": {"type": "string", "minLength": 1},
    "failure_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
    },
    "exception_type": {"type": "string", "minLength": 1},
    "message_persisted": {"const": false},
    "orders_allowed": {"const": false},
    "automatic_submission": {"const": false},
    "paper_eligibility": {"const": false},
    "trade_eligibility": {"const": false},
    "live_supported": {"const": false},
    "failure_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

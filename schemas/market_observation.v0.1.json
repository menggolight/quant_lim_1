{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/schemas/market_observation.v0.1.json",
  "title": "CN market observation v0.1",
  "description": "宏观、行业和个股三层市场观察的诊断契约。Schema 只校验结构，不证明来源真实、数据完整或因子已获准用于交易。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "status",
    "as_of",
    "market_as_of",
    "decision_time",
    "generated_at",
    "market",
    "horizons_trading_days",
    "purpose",
    "overall",
    "macro",
    "industry",
    "stock",
    "three_layer_conflicts",
    "deep_read_queue",
    "data_quality"
  ],
  "properties": {
    "schema_version": {
      "const": "market-observation-v0.1"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "status": {
      "const": "diagnostic_only_not_admitted"
    },
    "as_of": {
      "$ref": "#/$defs/date"
    },
    "market_as_of": {
      "$ref": "#/$defs/timezoneDateTime",
      "description": "本次市场快照在决策时点前实际可获得的时点。"
    },
    "decision_time": {
      "$ref": "#/$defs/timezoneDateTime"
    },
    "generated_at": {
      "$ref": "#/$defs/timezoneDateTime"
    },
    "market": {
      "const": "CN"
    },
    "horizons_trading_days": {
      "const": [
        20,
        60
      ]
    },
    "purpose": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "overall": {
      "$ref": "#/$defs/overall"
    },
    "macro": {
      "$ref": "#/$defs/macro"
    },
    "industry": {
      "$ref": "#/$defs/industry"
    },
    "stock": {
      "$ref": "#/$defs/stock"
    },
    "three_layer_conflicts": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "deep_read_queue": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/deepReadItem"
      }
    },
    "data_quality": {
      "$ref": "#/$defs/dataQuality"
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "pipeline": {
      "$ref": "#/$defs/pipeline"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timezoneDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "dateOrTimezoneDateTime": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "$ref": "#/$defs/timezoneDateTime"
        }
      ]
    },
    "httpSource": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^https?://"
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "returnNumber": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -100
    },
    "nonEmptyStringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macro_environment",
        "market_state",
        "risk_budget_observation",
        "research_action",
        "trade_action"
      ],
      "properties": {
        "macro_environment": {
          "$ref": "#/$defs/shortString"
        },
        "market_state": {
          "$ref": "#/$defs/shortString"
        },
        "risk_budget_observation": {
          "$ref": "#/$defs/shortString"
        },
        "research_action": {
          "const": "observe_only"
        },
        "trade_action": {
          "type": "null",
          "const": null,
          "description": "观察层禁止形成交易动作。"
        }
      }
    },
    "macroObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "period",
        "available_at",
        "source"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9_]+$"
        },
        "period": {
          "$ref": "#/$defs/shortString"
        },
        "available_at": {
          "$ref": "#/$defs/dateOrTimezoneDateTime"
        },
        "value": {
          "$ref": "#/$defs/nullableNumber"
        },
        "unit": {
          "$ref": "#/$defs/shortString"
        },
        "return_1d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "return_20d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "return_60d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "source": {
          "$ref": "#/$defs/httpSource"
        }
      },
      "anyOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "return_20d_pct"
          ]
        },
        {
          "required": [
            "return_60d_pct"
          ]
        }
      ]
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "liquidity",
        "credit_transmission",
        "growth_momentum",
        "inflation_pressure",
        "currency_pressure",
        "equity_risk_appetite",
        "observations",
        "invalidation",
        "unknowns"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/shortString"
        },
        "liquidity": {
          "$ref": "#/$defs/shortString"
        },
        "credit_transmission": {
          "$ref": "#/$defs/shortString"
        },
        "growth_momentum": {
          "$ref": "#/$defs/shortString"
        },
        "inflation_pressure": {
          "$ref": "#/$defs/shortString"
        },
        "currency_pressure": {
          "$ref": "#/$defs/shortString"
        },
        "equity_risk_appetite": {
          "$ref": "#/$defs/shortString"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/macroObservation"
          }
        },
        "invalidation": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "unknowns": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "crossSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "up_1d_count",
        "above_prior_ma20_count",
        "above_prior_ma60_count",
        "outperform_20d_count",
        "outperform_60d_count",
        "sector_count",
        "constituent_breadth_available"
      ],
      "properties": {
        "up_1d_count": {
          "type": "integer",
          "minimum": 0
        },
        "above_prior_ma20_count": {
          "type": "integer",
          "minimum": 0
        },
        "above_prior_ma60_count": {
          "type": "integer",
          "minimum": 0
        },
        "outperform_20d_count": {
          "type": "integer",
          "minimum": 0
        },
        "outperform_60d_count": {
          "type": "integer",
          "minimum": 0
        },
        "sector_count": {
          "type": "integer",
          "minimum": 1
        },
        "constituent_breadth_available": {
          "type": "boolean"
        }
      }
    },
    "sector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "state",
        "return_1d_pct",
        "return_20d_pct",
        "excess_20d_pct",
        "return_60d_pct",
        "excess_60d_pct",
        "above_prior_ma20",
        "above_prior_ma60",
        "turnover_ratio"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        },
        "name": {
          "$ref": "#/$defs/shortString"
        },
        "state": {
          "$ref": "#/$defs/shortString"
        },
        "return_1d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "return_20d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "excess_20d_pct": {
          "$ref": "#/$defs/nullableNumber"
        },
        "return_60d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "excess_60d_pct": {
          "$ref": "#/$defs/nullableNumber"
        },
        "above_prior_ma20": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "above_prior_ma60": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "turnover_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "industry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "classification_as_of",
        "available_at",
        "benchmark_id",
        "benchmark_name",
        "benchmark_return_1d_pct",
        "benchmark_return_20d_pct",
        "benchmark_return_60d_pct",
        "benchmark_turnover_cny_100m",
        "benchmark_turnover_ratio_vs_prior_20d",
        "cross_section",
        "sectors",
        "source_template",
        "methodology_source",
        "limitations"
      ],
      "properties": {
        "classification": {
          "$ref": "#/$defs/shortString"
        },
        "classification_as_of": {
          "$ref": "#/$defs/date"
        },
        "available_at": {
          "$ref": "#/$defs/timezoneDateTime"
        },
        "benchmark_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "benchmark_name": {
          "$ref": "#/$defs/shortString"
        },
        "benchmark_return_1d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "benchmark_return_20d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "benchmark_return_60d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "benchmark_turnover_cny_100m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "benchmark_turnover_ratio_vs_prior_20d": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cross_section": {
          "$ref": "#/$defs/crossSection"
        },
        "sectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sector"
          }
        },
        "source_template": {
          "$ref": "#/$defs/httpSource"
        },
        "methodology_source": {
          "$ref": "#/$defs/httpSource"
        },
        "limitations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "peerPrice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stock_id",
        "name",
        "close",
        "price_available_at",
        "return_20d_pct",
        "return_60d_pct"
      ],
      "properties": {
        "stock_id": {
          "$ref": "#/$defs/stockId"
        },
        "name": {
          "$ref": "#/$defs/shortString"
        },
        "close": {
          "$ref": "#/$defs/positiveNullableNumber"
        },
        "price_available_at": {
          "$ref": "#/$defs/timezoneDateTime"
        },
        "return_20d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "return_60d_pct": {
          "$ref": "#/$defs/returnNumber"
        }
      }
    },
    "stockId": {
      "type": "string",
      "pattern": "^[0-9]{6}\\.(?:SH|SZ|BJ)$"
    },
    "positiveNullableNumber": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "focusStock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stock_id",
        "name",
        "state",
        "close",
        "price_available_at",
        "return_20d_pct",
        "return_60d_pct",
        "excess_vs_csi300_20d_pct_points",
        "excess_vs_csi300_60d_pct_points",
        "excess_vs_home_appliance_etf_20d_pct_points",
        "excess_vs_home_appliance_etf_60d_pct_points",
        "latest_close_drawdown_from_20d_high_pct",
        "fundamental_as_of",
        "fundamental_available_at",
        "revenue_yoy_pct",
        "net_profit_parent_yoy_pct",
        "net_profit_ex_items_yoy_pct",
        "operating_cash_flow_yoy_pct",
        "supporting_evidence",
        "counter_evidence",
        "price_source",
        "fundamental_source"
      ],
      "properties": {
        "stock_id": {
          "$ref": "#/$defs/stockId"
        },
        "name": {
          "$ref": "#/$defs/shortString"
        },
        "state": {
          "$ref": "#/$defs/shortString"
        },
        "close": {
          "$ref": "#/$defs/positiveNullableNumber"
        },
        "price_available_at": {
          "$ref": "#/$defs/timezoneDateTime"
        },
        "return_20d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "return_60d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "excess_vs_csi300_20d_pct_points": {
          "$ref": "#/$defs/nullableNumber"
        },
        "excess_vs_csi300_60d_pct_points": {
          "$ref": "#/$defs/nullableNumber"
        },
        "excess_vs_home_appliance_etf_20d_pct_points": {
          "$ref": "#/$defs/nullableNumber"
        },
        "excess_vs_home_appliance_etf_60d_pct_points": {
          "$ref": "#/$defs/nullableNumber"
        },
        "latest_close_drawdown_from_20d_high_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "fundamental_as_of": {
          "$ref": "#/$defs/shortString"
        },
        "fundamental_available_at": {
          "$ref": "#/$defs/dateOrTimezoneDateTime"
        },
        "revenue_yoy_pct": {
          "$ref": "#/$defs/nullableNumber"
        },
        "net_profit_parent_yoy_pct": {
          "$ref": "#/$defs/nullableNumber"
        },
        "net_profit_ex_items_yoy_pct": {
          "$ref": "#/$defs/nullableNumber"
        },
        "operating_cash_flow_yoy_pct": {
          "$ref": "#/$defs/nullableNumber"
        },
        "supporting_evidence": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "counter_evidence": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "price_source": {
          "$ref": "#/$defs/httpSource"
        },
        "fundamental_source": {
          "$ref": "#/$defs/httpSource"
        }
      }
    },
    "crossIndustrySample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "industry",
        "stock_id",
        "name",
        "state",
        "close",
        "price_available_at",
        "return_20d_pct",
        "industry_ex_stock_return_20d_pct_approx",
        "excess_20d_pct_points_approx",
        "return_60d_pct",
        "industry_return_60d_including_stock_pct",
        "excess_60d_pct_points_approx",
        "support",
        "counter_evidence",
        "watch_reason",
        "invalidation",
        "fundamental_available_at",
        "fundamental_source"
      ],
      "properties": {
        "industry": {
          "$ref": "#/$defs/shortString"
        },
        "stock_id": {
          "$ref": "#/$defs/stockId"
        },
        "name": {
          "$ref": "#/$defs/shortString"
        },
        "state": {
          "$ref": "#/$defs/shortString"
        },
        "close": {
          "$ref": "#/$defs/positiveNullableNumber"
        },
        "price_available_at": {
          "$ref": "#/$defs/timezoneDateTime"
        },
        "return_20d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "industry_ex_stock_return_20d_pct_approx": {
          "$ref": "#/$defs/nullableNumber"
        },
        "excess_20d_pct_points_approx": {
          "$ref": "#/$defs/nullableNumber"
        },
        "return_60d_pct": {
          "$ref": "#/$defs/returnNumber"
        },
        "industry_return_60d_including_stock_pct": {
          "$ref": "#/$defs/nullableNumber"
        },
        "excess_60d_pct_points_approx": {
          "$ref": "#/$defs/nullableNumber"
        },
        "support": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "counter_evidence": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "watch_reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "invalidation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fundamental_available_at": {
          "$ref": "#/$defs/dateOrTimezoneDateTime"
        },
        "fundamental_source": {
          "$ref": "#/$defs/httpSource"
        }
      }
    },
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_at",
        "focus",
        "peer_prices",
        "cross_industry_observation_samples",
        "limitations"
      ],
      "properties": {
        "available_at": {
          "$ref": "#/$defs/timezoneDateTime"
        },
        "focus": {
          "$ref": "#/$defs/focusStock"
        },
        "peer_prices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/peerPrice"
          }
        },
        "cross_industry_observation_samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/crossIndustrySample"
          }
        },
        "limitations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "deepReadItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "subject",
        "reason"
      ],
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "subject": {
          "$ref": "#/$defs/shortString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "dataQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_industry_source",
        "official_macro_sources",
        "tencent_market_history",
        "eastmoney_market_history",
        "eastmoney_industry_board",
        "point_in_time_constituent_breadth",
        "official_trade_calendar_adapter",
        "formal_factor_eligibility"
      ],
      "properties": {
        "official_industry_source": {
          "$ref": "#/$defs/shortString"
        },
        "official_macro_sources": {
          "$ref": "#/$defs/shortString"
        },
        "tencent_market_history": {
          "$ref": "#/$defs/shortString"
        },
        "eastmoney_market_history": {
          "$ref": "#/$defs/shortString"
        },
        "eastmoney_industry_board": {
          "$ref": "#/$defs/shortString"
        },
        "point_in_time_constituent_breadth": {
          "$ref": "#/$defs/shortString"
        },
        "official_trade_calendar_adapter": {
          "$ref": "#/$defs/shortString"
        },
        "formal_factor_eligibility": {
          "const": false
        }
      }
    },
    "comparisonValue": {
      "type": [
        "string",
        "null"
      ]
    },
    "overallStateChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "from",
        "to"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "from": {
          "$ref": "#/$defs/comparisonValue"
        },
        "to": {
          "$ref": "#/$defs/comparisonValue"
        }
      }
    },
    "subjectStateChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "subject_name",
        "from",
        "to",
        "change_type"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subject_name": {
          "$ref": "#/$defs/shortString"
        },
        "from": {
          "$ref": "#/$defs/comparisonValue"
        },
        "to": {
          "$ref": "#/$defs/comparisonValue"
        },
        "change_type": {
          "enum": [
            "changed",
            "added",
            "removed"
          ]
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "previous_observation_id",
        "previous_as_of",
        "previous_sha256",
        "overall_state_changes",
        "industry_state_changes",
        "stock_state_changes",
        "new_conflicts",
        "resolved_conflicts",
        "has_material_change"
      ],
      "properties": {
        "status": {
          "enum": [
            "first_baseline",
            "compared"
          ]
        },
        "previous_observation_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "previous_as_of": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "overall_state_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overallStateChange"
          }
        },
        "industry_state_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subjectStateChange"
          }
        },
        "stock_state_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subjectStateChange"
          }
        },
        "new_conflicts": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "resolved_conflicts": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "has_material_change": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "first_baseline"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "previous_observation_id": {
                "type": "null"
              },
              "previous_as_of": {
                "type": "null"
              },
              "previous_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "compared"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "previous_observation_id",
              "previous_as_of",
              "previous_sha256"
            ],
            "properties": {
              "previous_observation_id": {
                "type": "string",
                "minLength": 1
              },
              "previous_as_of": {
                "$ref": "#/$defs/date"
              },
              "previous_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "standard_cli_generated",
        "sealed_at",
        "schema_path",
        "schema_sha256",
        "draft_sha256"
      ],
      "properties": {
        "producer": {
          "$ref": "#/$defs/shortString"
        },
        "standard_cli_generated": {
          "const": true
        },
        "sealed_at": {
          "$ref": "#/$defs/timezoneDateTime",
          "description": "标准 CLI 实际密封观察产物的时点，必须由生产者生成，不能继承或复制自 draft。"
        },
        "schema_path": {
          "type": "string",
          "minLength": 28,
          "maxLength": 2048,
          "pattern": "(?:^|/)market_observation\\.v0\\.1\\.json$"
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "draft_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}

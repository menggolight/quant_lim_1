{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant.local/schemas/daily_signal_admission_receipt.v1.json",
  "title": "Fixed-registry Daily signal admission receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "strategy_id", "strategy_date", "execution_date",
    "frozen_at", "authority", "intent_type", "alpha_ranking_sha256",
    "model_sha256", "approved_factor_registry_sha256",
    "model_admission_receipt_sha256", "exposure_decision_sha256",
    "exposure_state_sha256", "exposure_state", "exposure_target_gross",
    "construction_sha256", "intent_sha256", "exposure_policy_sha256",
    "constructor_policy_sha256", "combined_policy_sha256",
    "account_state_sha256", "account_fingerprint", "calendar_receipt_sha256",
    "calendar_registry_sha256", "execution_rule_bundle_sha256",
    "daily_decision_sha256", "experiment_admission_receipt_sha256",
    "formal_v3_loader_status", "authority_receipt_sha256", "failure_receipt_sha256",
    "next_session_allowed", "automatic_submission", "paper_eligibility",
    "trade_eligibility", "live_supported", "admission_receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "daily-signal-admission-receipt.v1"},
    "strategy_id": {"const": "a-share-small-account-adaptive-exposure-v2"},
    "strategy_date": {"type": "string", "format": "date"},
    "execution_date": {"type": ["string", "null"], "format": "date"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "authority": {"enum": ["BLOCKED", "RISK_REDUCTION_ONLY"]},
    "intent_type": {"type": "string", "minLength": 1},
    "alpha_ranking_sha256": {"$ref": "#/$defs/sha256"},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "approved_factor_registry_sha256": {"$ref": "#/$defs/sha256"},
    "model_admission_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "exposure_decision_sha256": {"$ref": "#/$defs/sha256"},
    "exposure_state_sha256": {"$ref": "#/$defs/sha256"},
    "exposure_state": {"type": "string", "minLength": 1},
    "exposure_target_gross": {"$ref": "#/$defs/decimal"},
    "construction_sha256": {"$ref": "#/$defs/sha256"},
    "intent_sha256": {"$ref": "#/$defs/sha256"},
    "exposure_policy_sha256": {"$ref": "#/$defs/sha256"},
    "constructor_policy_sha256": {"$ref": "#/$defs/sha256"},
    "combined_policy_sha256": {"$ref": "#/$defs/sha256"},
    "account_state_sha256": {"$ref": "#/$defs/sha256"},
    "account_fingerprint": {"$ref": "#/$defs/sha256"},
    "calendar_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "calendar_registry_sha256": {"$ref": "#/$defs/sha256"},
    "execution_rule_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "daily_decision_sha256": {"$ref": "#/$defs/sha256"},
    "experiment_admission_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "formal_v3_loader_status": {"const": "blocked_not_implemented"},
    "authority_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "failure_receipt_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "next_session_allowed": {"type": "boolean"},
    "automatic_submission": {"const": false},
    "paper_eligibility": {"const": false},
    "trade_eligibility": {"const": false},
    "live_supported": {"const": false},
    "admission_receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}
  }
}
